FROM python:3.12-slim

WORKDIR /app

# VULNERABLE: secrets baked into image via ENV/ARG
ENV API_KEY=hardcoded_api_key_value_1234567890
ENV DATABASE_PASSWORD=supersecret_db_pass
ARG SECRET_TOKEN=build_time_secret_token
ARG PRIVATE_KEY=-----BEGIN-PRIVATE-KEY-----

COPY . .
RUN pip install -r requirements.txt

USER 1001
CMD ["python", "app.py"]
